{
  "name": "fx580vnx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline emulator of the Casio fx-580VN X scientific calculator",
  "workspaces": [
    "engine",
    "ui"
  ],
  "scripts": {
    "dev": "npm run dev -w ui",
    "build": "npm run typecheck && npm run build -w ui",
    "typecheck": "tsc -p engine/tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "npm run test -w engine",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "package": "tauri build",
    "package:dir": "tauri build --no-bundle",
    "e2e": "node scripts/e2e.mjs",
    "smoke:tauri": "node scripts/tauri-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "author": "fx580vnx contributors"
}
